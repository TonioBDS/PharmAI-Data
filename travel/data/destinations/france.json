   },
   {
    "id": "hepatitis-b",
    "fr": "Hépatite B",
    "en": "Hepatitis B",
    "url": "https://www.cdc.gov/hepatitis-b/index.html",
    "updated": null,
    "text": [
     {
      "text": "Recommended for unvaccinated travelers younger than 60 years old traveling to France. Unvaccinated travelers 60 years and older may get vaccinated before traveling to France."
     }
    ],
    "references": [
     {
